POSTGRES_USER=alandas
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=alandas_system1

TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
TEMPORAL_POSTGRES_DB=temporal

TEMPORAL_VERSION=1.27.2
TEMPORAL_ADMINTOOLS_VERSION=1.32.0
TEMPORAL_UI_VERSION=2.39.0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alandas-system1
TEMPORAL_CORS_ORIGINS=http://localhost:8080

# Generate a Base64-encoded bcrypt hash with the command in
# system_1/DEPLOYMENT_COOLIFY.md. Never put the plaintext password in Git.
TEMPORAL_UI_AUTH_USER=replace-with-a-dedicated-ui-username
TEMPORAL_UI_AUTH_PASSWORD_HASH_B64=replace-with-a-base64-encoded-bcrypt-hash

# Keep false until the bounded public-site research check is deliberately enabled.
SYSTEM1_PUBLIC_RESEARCH_ENABLED=false

# Keep false until the public callback URL, token, and a $0 test are reviewed.
SYSTEM1_OUTSCRAPER_WEBHOOK_ENABLED=false
# Generate at least 32 random characters. Store it only in Coolify.
OUTSCRAPER_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# Automated discovery trial. Keep false until the one capped live run is
# separately approved. Enter real tokens only in Coolify, never this file.
SYSTEM1_DISCOVERY_ENABLED=false
SYSTEM1_DISCOVERY_MAX_APIFY_USD=1.40
SYSTEM1_DISCOVERY_MAX_OUTSCRAPER_USD=0.60
APIFY_API_TOKEN=enter-only-in-coolify
OUTSCRAPER_API_KEY=enter-only-in-coolify
# Base public HTTPS URL of system1-webhook, without the path or token.
SYSTEM1_DISCOVERY_OUTSCRAPER_CALLBACK_BASE_URL=https://replace-with-webhook-domain
# The date the seven-day period begins. Use today's Berlin date only after the
# manual test is accepted.
SYSTEM1_DISCOVERY_TRIAL_START_DATE=2026-09-17

LOG_LEVEL=info
