POSTGRES_USER=alandas
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=alandas_system1

TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
TEMPORAL_POSTGRES_DB=temporal

TEMPORAL_VERSION=1.27.2
TEMPORAL_ADMINTOOLS_VERSION=1.32.0
TEMPORAL_UI_VERSION=2.39.0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alandas-system1
TEMPORAL_CORS_ORIGINS=http://localhost:8080

# Generate a bcrypt hash with the command in system_1/DEPLOYMENT_COOLIFY.md.
# Never put the plaintext password in this file or in Git.
TEMPORAL_UI_AUTH_USER=replace-with-a-dedicated-ui-username
TEMPORAL_UI_AUTH_PASSWORD_HASH=replace-with-a-bcrypt-password-hash

LOG_LEVEL=info
