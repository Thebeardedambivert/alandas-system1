#!/bin/sh
set -eu

: "${TEMPORAL_UI_AUTH_USER:?TEMPORAL_UI_AUTH_USER is required}"
: "${TEMPORAL_UI_AUTH_PASSWORD_HASH_B64:?TEMPORAL_UI_AUTH_PASSWORD_HASH_B64 is required}"

# Coolify can expand `$` in bcrypt values. Store a Base64-encoded bcrypt hash
# instead, then decode it only inside the gateway process.
auth_hash="$(printf %s "$TEMPORAL_UI_AUTH_PASSWORD_HASH_B64" | base64 -d | tr -d '\r\n')"

case "$auth_hash" in
  '$2a$'*|'$2b$'*|'$2y$'*) ;;
  *)
    echo "TEMPORAL_UI_AUTH_PASSWORD_HASH_B64 did not decode to a bcrypt hash" >&2
    exit 64
    ;;
esac

if [ "${#auth_hash}" -ne 60 ]; then
  echo "TEMPORAL_UI_AUTH_PASSWORD_HASH_B64 decoded to an invalid bcrypt length" >&2
  exit 64
fi

export TEMPORAL_UI_AUTH_PASSWORD_HASH="$auth_hash"
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
